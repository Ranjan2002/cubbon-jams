# Google Maps API Key
# Get your key from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Admin credentials for the /admin panel
# ADMIN_USERNAME and ADMIN_PASSWORD_HASH are required in production.
# Generate ADMIN_PASSWORD_HASH with: node -e "const b=require('bcryptjs');console.log(b.hashSync('your_password',10))"
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password

# JWT Secret — use a long random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Optional
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_SITE_URL=https://cubbon-jams.netlify.app
